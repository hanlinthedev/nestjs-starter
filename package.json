{
  "name": "api-starter",
  "type": "module",
  "version": "0.1.0",
  "description": "Reusable NestJS REST API starter with Prisma PostgreSQL and Passport authentication",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run contract:emit && npm run typecheck && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "contract:emit": "prisma contract emit",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint:fix": "npm run lint -- --fix",
    "db:init": "prisma db init",
    "db:verify": "prisma db verify",
    "db:migrate": "prisma db migrate",
    "db:plan": "prisma migration plan",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "bcrypt": "6.0.0",
    "dotenv": "18.0.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@prisma/cli-engine": "0.4.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "16.5.0",
    "prettier": "3.9.8",
    "prisma": "8.0.0-rc.15",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "swc": "1.0.11",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  }
}
